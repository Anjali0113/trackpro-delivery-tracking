{
  "name": "track",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "dev:all": "concurrently -k -n API,WEB -c cyan,magenta \"npm run server:dev\" \"npm run dev\"",
    "setup": "npm install && npm --prefix server install",
    "reset-data": "node -e \"require('fs').rmSync('server/data',{recursive:true,force:true})\""
  },
  "dependencies": {
    "axios": "^1.20.0",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.58.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "concurrently": "^9.0.1"
  }
}